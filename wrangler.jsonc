{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hidden-eleven",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Gera src/dados.gen.js a partir de data/jogos/*.json antes de cada dev/deploy.
  "build": {
    "command": "node scripts/gerar-dados.mjs",
    "watch_dir": "data"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/sala/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SALAS", "class_name": "Sala" }]
  },
  // SQLite é obrigatório para Durable Objects no plano gratuito.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }],
  "observability": { "enabled": true }
}
